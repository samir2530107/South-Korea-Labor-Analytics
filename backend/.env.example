# Local MySQL defaults. Copy this file to .env and set your own password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=south_korea_labor_market
PORT=5000

# Optional for hosted MySQL:
# DB_SSL=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Or point to a CA file relative to the backend directory:
# DB_SSL_CA_PATH=certs/ca.pem
